*Primary Programmer: Marzan Khan*Purpose: Calculate nursing home time prior to Paxlovid initation*Last Updated: April 19, 2026;*Subset the stays and episode file to master_patient_id in my cohort;proc sql;	create table output.stays as	select *	from ltcdc.stay_update_1	where master_patient_id in (select master_patient_id from data.table1_final);quit;proc sql;	create table output.episode as	select *	from ltcdc.episode	where master_patient_id in (select master_patient_id from data.table1_final);quit;*Find earliest and latest last day of course initiation;proc freq data=output.Pax_2;	tables date;run;*By course_id, select earliest and latest course start and end dates;proc sql;	create table dates1 as	select distinct course_id, min(date) as min_course_date format=date9. , max(date) as max_course_date format=date9.,	master_patient_id	from output.Pax_2	group by course_id;quit;data dates2;	set dates1;	lookback_start=min_course_date-180;	lookback_end=min_course_date-1;	format lookback_end lookback_start date9.;run;proc freq data=dates2;	tables lookback_start;run;*Merge each record to all stays;proc sql;	create table merged as	select *	from dates2 as a	left join output.nonoverlap_stays_cont as b	on a.master_patient_id=b.master_patient_id;quit;*Flag all stays where the start date is less than  or equal to the lookback end;data merged2;	set merged;	if start_date_d<=lookback_end then time=1;	else time=0;run;*Check the distribution of the time flag variable;proc freq data=merged2;	tables time;run;*Create nursing home start and end dates;data merged3;	set merged2;		if time=1 then do;	nh_end=min(end_date_d, lookback_end);	nh_start=start_date_d;	end;		if time=0 then nh_time=0;	else nh_time=nh_end-nh_start+1;	if nh_time=. then nh_time=0;	format nh_start nh_end date9.;run;*Subset to first course per resident;proc sort data=merged3 ;	by master_patient_id min_course_date;run;proc sort data=merged3 out=nodup_    nodupkey;	by master_patient_id ;run;*Check the distribution of the nursing home time variable;proc freq data=merged3;	tables nh_time;run;proc sgplot data=merged4;	histogram nh_time_total;run;proc freq data=merged4;	tables nh_time_total;run;*Mean IQR nursing home time;proc means data=merged4 n maxdec=1 mean std median qrange q1 q3;	var nh_time_total ;run;proc freq data=merged4;	tables nh_time_total;run;*******************************************************************************************************************;*Calculate nursing home time statistics by interacting meds;data stratified;	set data.drug_indicators (drop=drug_paxlovid);	sum_drug=sum(of drug_:);	if sum_drug=0 then ddi=0; else ddi=1;run;proc freq data=stratified;tables sum_drug ddi;run;proc sql;	create table output.stays_ddi  as	select a.*, b.nh_time_total,		case when b.nh_time_total>100 then 1 else 0 end as long_stay	from stratified  as a	left join merged4 as b	on a.master_patient_id=b.master_patient_id;quit;proc freq data=output.stays_ddi ;	tables long_stay;	where ddi=0;run;proc freq data=output.stays_ddi ;	tables long_stay;	where ddi=1;run;proc means data=output.stays_ddi n maxdec=1 mean std median q1 q3;	var nh_time_total ;	class ddi;run;