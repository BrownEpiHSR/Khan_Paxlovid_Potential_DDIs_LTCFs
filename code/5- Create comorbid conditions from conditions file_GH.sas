sum_drug=0 then ddi=0; else ddi=1;run;proc freq data=stratified;tables sum_drug ddi;run;proc sql;	create table output.conditions_interact   as	select a.*, b.diabetes_ever, b.dementia_ever, b.ckd_ever, b.chf_ever	from stratified  as a	left join data.conditions_pax2 as b	on a.master_patient_id=b.master_patient_id;quit;proc freq data=output.conditions_interact ;	tables  (diabetes_ever dementia_ever ckd_ever chf_ever)*ddi;run;