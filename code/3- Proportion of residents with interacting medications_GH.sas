 maximum value of num_interact per resident;proc sql;	create table resident_max as	select master_patient_id,	max(num_interact) as max_ddi_count, max(other_inhib) as inhib_ind,	max(drug_diltiazem) as max_diltiazem,	max(drug_amiodarone) as max_amiodarone,	max(drug_verapamil) as max_verapamil,	max(drug_erythromycin) as max_erythromycin,	max(drug_ketoconazole) as max_ketoconazole	from interact_meds	group by master_patient_id;quit;*Create indicators for >=2 and >=3 interacting medications;data resident_max2;	set resident_max;	ge1=(max_ddi_count>=1);	ge2=(max_ddi_count>=2);	ge3=(max_ddi_count>=3);run;*check the distributions for reporting;proc freq data=resident_max2;;	tables ge1 ge2 ge3;run;proc freq data=resident_max2;	tables inhib_ind max_diltiazem max_amiodarone max_verapamil max_erythromycin max_ketoconazole;run;proc freq data=resident_max2;	tables inhib_ind max_diltiazem max_amiodarone max_verapamil max_erythromycin max_ketoconazole;	where ge1=0;run;/**/