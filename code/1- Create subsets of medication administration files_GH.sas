*Primary Programmer: Marzan Khan*Purpose: Create subsets of medication administration files that will be used to identify statistics onpolypharmacy during the 180 day lookback period from initiaiton of Paxlovid course*Last Updated: April 19, 2026;*Create subsets of the medication files-limiting to mater_patient_id in my final nirmatrelvir/ritonavir cohort;%macro medi (year);proc sql;	create table output.medadmin_&year as	select *	from ltcdc.medication_admin_&year	where master_patient_id in (select master_patient_id from output.paxlovid_final);quit;%mend;%medi (2021);%medi (2022);%medi (2023);%medi (2024);%medi (2025);