*Primary Programmer: Marzan Khan*Purpose: Generate statistics on polypharmacy during the 180 day lookback period from initiaiton of Paxlovid course*Last Updated: April 19, 2026;*By course_id, select earliest and latest course start and end dates;proc sql;	create table dates1 as	select distinct course_id, min(date) as min_course_date format=date9. , max(date) as max_course_date format=date9.,	master_patient_id	from output.Pax_2	group by course_id;quit;*For my cohort, check for medications in the last 180 days;*Create lookback start and end dates;data dates2;	set dates1;	lookback_start=min_course_date-180;	lookback_end=min_course_date-1;	format lookback_start lookback_end date9.;run;*Check the distribution of the course start dates;proc freq data=dates2;	tables min_course_date;run;*Stack the subsets of medication administrations files for 2021-2025 created in the program called1-Create subsets of medication administration files;data output.stack_meds;	set output.medadmin_2021 output.medadmin_2022 output.medadmin_2023 output.medadmin_2024 output.medadmin_2025;	*Flag administrations of paxlovid;	foundin_generic_pax=0;	foundin_name_pax=0;	if find(medication_generic_name, "nirmatrelvir", "i")>0 or find(medication_generic_name, "paxlovid", "i")>0  or find(medication_generic_name, "ritonavir", "i")>0  then foundin_generic_pax=1;	if find(medication_name, "nirmatrelvir", "i")>0 or find(medication_name, "paxlovid", "i")>0 or find(medication_name, "ritonavir", "i")>0  then foundin_name_pax=1;	*Flag administrations of molnupiravir---this step was not required;	foundin_generic_mol=0;	foundin_name_mol=0;	if find(medication_generic_name, "molnupiravir", "i")>0 or find(medication_generic_name, "lagevrio", "i")>0   then foundin_generic_mol=1;	if find(medication_name, "molnupiravir", "i")>0 or find(medication_name, "lagevrio", "i")>0   then foundin_name_mol=1;	*Delete administrations of paxlovid only;	if  foundin_name_pax=1 or foundin_generic_pax=1 then delete;	date_meds=datepart(medication_event_date);	format date_meds date9.;run;*Remove medications that were administtered more than once on the same day;proc sort data=output.stack_meds out=meds_nodup nodupkey;	by master_patient_id date_meds medication_generic_name;	where medication_generic_name~=" ";run;*join the deduplicated medicaitons to each row by master_patient_id, which is each course_id;proc sql;	create table meds1 as	select a.*, b.medication_generic_name as other_meds, b.date_meds	from dates2 as a	left join meds_nodup as b	on a.master_patient_id=b.master_patient_id;quit;*Flag medications that were administered during the 180 day lokback period as overlap_meds=1;*Flag medications that were administered outside of the 180 day lookback period as overlap_meds=2;*Flag records whithout any administratations at all during 2021-2025 as overlap_meds=0;data meds2;	set meds1;	if date_meds=. then overlap_meds=0;	else if lookback_start<=date_meds<=lookback_end then overlap_meds=1;	else overlap_meds=2;run;*Check the distribution of the overlap_meds variable;proc freq data=meds2;	tables overlap_meds;run;proc print data=meds2 (obs=20);	var master_patient_id lookback_start date_meds lookback_end other_meds overlap_meds;	where overlap_meds=2;run;*Count distinct drugs during lookback among records where administrations occurred during the 180 day period;*Summarize by course_id;proc sql;	create table meds_withoverlap as 	select distinct course_id,  count(distinct other_meds) as num_drugs	from meds2 	where overlap_meds=1	group by course_id;quit;*Join the resulting file to the main file containing all courses;proc sql;	create table output.polypharmacy as	select *	from dates2 as a	left join meds_withoverlap as b	on a.course_id=b.course_id;quit;*in proc sql, update tableMakes sure to update, not necessarily run;*After the above merge step, num_drugs will be missing for those without any matches in meds_withoverlap, so changethe missing values to 0;data output.polypharmacy;	set output.polypharmacy;	if num_drugs=. then num_drugs=0;run;*Check the distribution of the num_drugs variable;proc sgplot data=output.polypharmacy;	histogram num_drugs;run;proc freq data=output.polypharmacy;	tables num_drugs;run;*Subset to first course per resident;proc sort data=output.polypharmacy ;	by master_patient_id min_course_date;run;proc sort data=output.polypharmacy out=nodup_poly nodupkey;	by master_patient_id ;run;	proc means data=nodup_poly mean std median q1 q3 maxdec=1;	var num_drugs;run;*******************************************************************************************************************;*Find the number of drugs by drug-drug-interaction;data stratified;	set data.drug_indicators (drop=drug_paxlovid);	sum_drug=sum(of drug_:);	if sum_drug=0 then ddi=0; else ddi=1;run;proc freq data=stratified;tables sum_drug ddi;run;proc sql;	create table output.poly_stratified  as	select a.*, b.num_drugs	from stratified  as a	left join nodup_poly as b	on a.master_patient_id=b.master_patient_id;quit;proc means data=output.poly_stratified n maxdec=1 mean std median q1 q3;	var num_drugs ;	class ddi;run;